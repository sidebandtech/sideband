{
  "name": "@sideband/peer",
  "version": "0.6.0",
  "description": "Peer SDK for Sideband: friendly API over runtime + transports with lifecycle utilities, pub/sub, and RPC helpers to run peers quickly.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidebandtech/sideband.git",
    "directory": "packages/peer"
  },
  "bugs": {
    "url": "https://github.com/sidebandtech/sideband/issues"
  },
  "homepage": "https://sideband.tech",
  "author": "Sideband <hello@sideband.tech>",
  "contributors": [
    "Konstantin Tarkus <koistya@kriasoft.com>"
  ],
  "keywords": [
    "sideband",
    "peer",
    "sdk",
    "client",
    "p2p",
    "rpc",
    "pubsub",
    "runtime",
    "transport"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/listen.d.ts",
      "bun": "./src/listen.ts",
      "default": "./dist/listen.js"
    },
    "./sbrp": {
      "types": "./dist/sbrp.d.ts",
      "bun": "./src/sbrp.ts",
      "default": "./dist/sbrp.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@sideband/protocol": "workspace:^",
    "@sideband/rpc": "workspace:^",
    "@sideband/runtime": "workspace:^",
    "@sideband/transport": "workspace:^",
    "@sideband/transport-ws": "workspace:^"
  },
  "peerDependencies": {
    "@sideband/secure-relay": ">=0.5.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@sideband/secure-relay": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "check:bundle": "bun run scripts/check-bundle-size.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
