{
  "name": "@sideband/transport-ws",
  "version": "0.4.0",
  "description": "WebSocket transport for Sideband with browser and Node.js/Bun support.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidebandtech/sideband.git",
    "directory": "packages/transport-ws"
  },
  "bugs": {
    "url": "https://github.com/sidebandtech/sideband/issues"
  },
  "homepage": "https://sideband.tech",
  "author": "Sideband <hello@sideband.tech>",
  "contributors": [
    "Konstantin Tarkus <koistya@kriasoft.com>"
  ],
  "keywords": [
    "sideband",
    "transport",
    "websocket",
    "browser",
    "node",
    "bun",
    "p2p"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "bun": "./src/browser.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "bun": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@sideband/protocol": "workspace:^",
    "@sideband/transport": "workspace:^",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}
