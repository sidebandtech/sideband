{
  "name": "@sideband/cloud",
  "version": "0.5.2",
  "description": "Cloud relay SDK for Sideband: connect clients and daemons via relay.sideband.cloud with automatic session management, token renewal, and E2EE.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidebandtech/sideband.git",
    "directory": "packages/cloud"
  },
  "bugs": {
    "url": "https://github.com/sidebandtech/sideband/issues"
  },
  "homepage": "https://sideband.tech",
  "author": "Sideband <hello@sideband.tech>",
  "contributors": [
    "Konstantin Tarkus <koistya@kriasoft.com>"
  ],
  "keywords": [
    "sideband",
    "cloud",
    "relay",
    "sdk",
    "e2ee",
    "end-to-end-encryption",
    "real-time",
    "rpc",
    "websocket",
    "p2p"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@sideband/peer": "workspace:^",
    "@sideband/secure-relay": "workspace:^",
    "@sideband/transport": "workspace:^",
    "@sideband/transport-ws": "workspace:^"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}
