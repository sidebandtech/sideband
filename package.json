{
  "name": "sideband",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "typecheck": "tsc --build tsconfig.check.json",
    "build": "tsc --build",
    "prepublishOnly": "bun run scripts/prepublish.ts",
    "release": "bun run prepublishOnly && bun changeset publish",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "docs:deploy": "gh-pages -d .vitepress/dist"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.10",
    "eslint": "^10.0.3",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "shiki": "^4.0.1",
    "srcpack": "^0.1.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitepress": "^2.0.0-alpha.16",
    "vitepress-plugin-llms": "^1.11.0"
  },
  "prettier": {
    "singleQuote": false,
    "semi": true
  }
}
